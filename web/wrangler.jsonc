{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static site: Cloudflare serves dist/ (with public/_headers) from its
  // edge, no Worker code runs.
  "name": "tabsh",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Needs tabsh.cc added as a zone in the same Cloudflare account.
  "routes": [{ "pattern": "tabsh.cc", "custom_domain": true }]
}
