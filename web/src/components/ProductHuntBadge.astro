---
// Product Hunt's official "featured" badge, always dark to match the page.
const href =
  'https://www.producthunt.com/products/tabsh?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-tabsh';
const src =
  'https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1292068&theme=dark&t=1792922682137';
---

<a class="ph-badge" href={href} target="_blank" rel="noopener noreferrer">
  <img
    src={src}
    alt="tabsh - A calmer way to work with agents, in a browser tab | Product Hunt"
    width="250"
    height="54"
    decoding="async"
  />
</a>

<style>
  /* The badge carries its own frame; keep the link quiet. */
  .ph-badge { display: inline-block; border: 0; }
  .ph-badge img { display: block; width: 250px; height: 54px; }
</style>
