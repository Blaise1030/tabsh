---
import { DAEMON_URL } from '../../site';
import '../../styles/app.css';
---
<!doctype html>
<html class="dark">
<head>
  <meta charset="utf-8">
  <!-- The daemon to connect to; `?daemon=` overrides it per visit. The daemon
       empties it when it serves this page itself, meaning "this origin". -->
  <meta name="tabsh-daemon" content={DAEMON_URL}>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>tabsh</title>
  <link rel="icon" id="favicon" type="image/svg+xml" href="data:,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;600&display=swap">
  <!-- Pinned with integrity: this page holds a token that opens shells. -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/basecoat.cdn.min.css" integrity="sha384-XWKdrxzE2X33lI8Q03C9fIbqdLWV11whVNycR2/3bMNJY73EEQOa7rmN+SeiSCor" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css" integrity="sha384-tStR1zLfWgsiXCF3IgfB3lBa8KmBe/lG287CL9WCeKgQYcp1bjb4/+mwN6oti4Co" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/basecoat.min.js" integrity="sha384-K1w/8BZNQc+02JnyibbylrLXh4mBzvzNIl0PZduEsb7JPR5GhJyrmsEVGQV7JTa+" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/command.min.js" integrity="sha384-i7Raf25qcUmot+J0dl2Hn1aKTz8JFiyFSRou847lNsO/CY+hA8SemZyxteOLd1hm" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.min.js" integrity="sha384-J4qzUjBl1FxyLsl/kQPQIOeINsmp17OHYXDOMpMxlKX53ZfYsL+aWHpgArvOuof9" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.min.js" integrity="sha384-XGqKrV8Jrukp1NITJbOEHwg01tNkuXr6uB6YEj69ebpYU3v7FvoGgEg23C1Gcehk" crossorigin="anonymous"></script>
</head>
<body>
  <dialog id="palette" class="command-dialog" aria-label="Command menu">
    <div class="command" id="palette-command">
      <header>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="palette-input" autocomplete="off" autocorrect="off" spellcheck="false"
               aria-autocomplete="list" role="combobox" aria-expanded="true" aria-controls="palette-menu">
      </header>
      <div role="menu" id="palette-menu" aria-orientation="vertical" data-empty="No results found."></div>
    </div>
  </dialog>

  <dialog id="about" class="dialog" aria-labelledby="about-title" aria-describedby="about-desc">
    <div>
      <header>
        <h2 id="about-title">tabsh</h2>
        <p id="about-desc">Terminals in your browser, served by a small Rust daemon.</p>
      </header>
      <section>
        <table class="table about-table">
          <tbody id="about-list"></tbody>
        </table>
      </section>
      <footer>
        <button type="button" class="btn">Close</button>
      </footer>
    </div>
  </dialog>

  <div id="workspace">
    <div id="main">
    <div class="tabbar">
      <div id="tabs" role="tablist" aria-label="Terminals"></div>
      <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="New terminal" title="New terminal" data-new-session>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      </button>
      <button type="button" class="btn settings-btn" data-variant="ghost" data-size="icon-sm" aria-label="Settings" id="settings-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <div id="terms">
      <div class="empty" id="empty" hidden>
        <p>No terminals open.</p>
        <button type="button" class="btn" data-new-session>New terminal</button>
      </div>
      <div class="empty" id="gate" hidden>
        <div data-gate="offline">
          <h2><span class="mark">#</span> CAN'T REACH TABSH ON THIS COMPUTER</h2>
          <p>Start it in a terminal. This page connects as soon as it's up.</p>
          <pre class="cmd"><span class="mark">$</span> tabsh</pre>
          <p class="mark">&gt; If your browser asks to let this site reach apps on your device, allow it.</p>
        </div>
        <div data-gate="safari">
          <h2><span class="mark">#</span> OPEN TABSH FROM YOUR COMPUTER</h2>
          <p>Safari doesn't let websites reach apps on your computer, so tabsh serves this page itself. Start it if it isn't running:</p>
          <pre class="cmd"><span class="mark">$</span> tabsh</pre>
          <p><a class="btn" id="open-local" href="#">Open tabsh</a></p>
          <p class="mark">&gt; Add it to your Dock (File → Add to Dock) to open it like an app.</p>
        </div>
        <div data-gate="pair">
          <h2><span class="mark">#</span> PAIR THIS BROWSER WITH TABSH</h2>
          <p>Open the link tabsh printed when it started, or paste it here.</p>
        </div>
        <form data-gate="pair" id="pair-form">
          <input class="input" id="pair-input" placeholder="https://…/app/#token=…" autocomplete="off" spellcheck="false" aria-label="Pairing link or token">
          <button type="submit" class="btn">Pair</button>
        </form>
      </div>
    </div>
    </div>
    <div id="pane-divider" hidden></div>
    <aside id="pane" hidden tabindex="-1" aria-label="File"></aside>
  </div>

  <div id="drop-glow" aria-hidden="true"></div>

  <template id="tab-template">
    <div class="tab" role="tab" aria-selected="false">
      <span></span>
      <button type="button" class="btn" data-variant="ghost" data-size="icon-xs" aria-label="Close terminal">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </template>

  <script>import '../../app/main.ts';</script>
</body>
</html>
