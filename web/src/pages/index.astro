---
import { DAEMON_URL, INSTALL_COMMAND, REPO_URL } from '../site';

const features = [
  ['Shells outlive the tab', 'Close, reload, quit: they reattach'],
  ['Survives restarts', 'Tabs, folders, scrollback restored'],
  ['Drop files in', 'Dragged files type their path'],
  ['Bells you notice', 'Tab rings, favicon badges'],
  ['Themes and fonts', '10 themes, 9 fonts, ⌘K palette'],
  ['Nothing leaves localhost', 'Keystrokes stay on 127.0.0.1'],
];

// Draw the features as an ASCII table, padded to the widest cell in each column.
// The script below redraws it at runtime with a wider second column to fill the page.
const w0 = Math.max(...features.map(([a]) => a.length));
const w1 = Math.max(...features.map(([, b]) => b.length));
const rule = `+${'-'.repeat(w0 + 2)}+${'-'.repeat(w1 + 2)}+`;
const table = [rule, ...features.map(([a, b]) => `| ${a.padEnd(w0)} | ${b.padEnd(w1)} |`), rule].join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tabsh: your terminal, in a browser tab</title>
    <meta name="description" content="A tiny Rust daemon runs your shells locally. Open them from any browser tab; they survive reloads and restarts." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <main>
      <header class="masthead">
        <div>
          <p>TABSH <span class="cursor" aria-hidden="true"></span></p>
          <p>YOUR TERMINAL, IN A BROWSER TAB</p>
          <p>2026</p>
        </div>
        <nav aria-label="Primary">
          <a href="/app/">[ START APP ]</a>
          <a href={REPO_URL}>[ GITHUB ]</a>
        </nav>
      </header>

      <h1><span class="mark">#</span> YOUR TERMINAL, IN A BROWSER TAB</h1>

      <p>
        A tiny Rust daemon runs your shells on your machine. Open them from any
        browser tab: they survive reloads, restarts and closed laptops.
      </p>

      <figure class="shot">
        <!-- A working mock of the app inside a browser window: tabs switch, open
             and close, the bell clears when you look, and the prompt takes input. -->
        <div class="browser" role="group" aria-label="Interactive demo: tabsh in a browser tab">
          <div class="chrome" aria-hidden="true">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="btab">
              <span class="favicon"><img src="/favicon.svg" alt="" width="14" height="14" /><i id="demo-badge"></i></span>
              tabsh
              <span class="mark">×</span>
            </span>
            <!-- The rest of the workday, in the tabs next door. -->
            <span class="btab bg">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
              <span class="label">Fix refund status · #142</span>
            </span>
            <span class="btab bg">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="4.2" stroke-linecap="round">
                <path stroke="#36c5f0" d="M3.5 9.5h6M9.5 3.5h0" /><path stroke="#2eb67d" d="M14.5 3.5v6M20.5 9.5h0" />
                <path stroke="#ecb22e" d="M14.5 14.5h6M14.5 20.5h0" /><path stroke="#e01e5a" d="M9.5 14.5v6M3.5 14.5h0" />
              </svg>
              <span class="label">#shop-eng</span>
            </span>
            <span class="btab bg">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9.5" /><path d="M2.5 12h19M12 2.5c3 3.2 3 15.8 0 19M12 2.5c-3 3.2-3 15.8 0 19" /></svg>
              <span class="label">Shop · localhost:5173</span>
            </span>
          </div>
          <div class="urlbar" aria-hidden="true"><span class="url" id="demo-url">/app/</span></div>
          <div class="app">
            <div class="app-bar">
              <div class="app-tabs" role="tablist" id="demo-tabs"></div>
              <button type="button" class="icon" id="demo-new" aria-label="New terminal">+</button>
              <span class="icon gear" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </div>
            <div class="screen" id="demo-screen" role="tabpanel" tabindex="0" aria-label="Terminal (demo). Type a command and press Enter."></div>
          </div>
        </div>
        <figcaption><span class="mark">fig. 1</span> three shells, one browser tab. The dot means claude wants you. Go on, click it.</figcaption>
      </figure>

      <pre class="cmd"><span class="mark">$</span> {INSTALL_COMMAND}  <button type="button" class="copy" data-copy={INSTALL_COMMAND} aria-label="Copy install command">[copy]</button>
<span class="mark">$</span> tabsh  <span class="mark"># prints a link that opens the app, paired</span></pre>

      <h2 id="why"><span class="mark">##</span> WHY A BROWSER TAB?</h2>
      <p>
        Look at where your work happens. The issue is in a tab. So is the pull
        request, the docs, the design, the chat with your team, the AI you ask
        for help, and the app you're building, running on localhost.
      </p>
      <p>
        The browser quietly became the place we work. The terminal is the last
        tool still living in a separate window, one ⌘-Tab away from everything
        it touches.
      </p>
      <p>
        So bring it home. Put the terminal where the work already is, in the
        tab next to the thing it builds.
      </p>

      <h2><span class="mark">##</span> FEATURES</h2>
      <pre class="table" data-rows={JSON.stringify(features)}>{table}</pre>

      <h2 id="how"><span class="mark">##</span> HOW IT CONNECTS</h2>
      <p>
        The app you open here is a plain page. It talks to the daemon on your own
        machine at <code>{DAEMON_URL}</code>. There is no server of ours in between.
      </p>
      <pre class="diagram">[ browser tab ]     this site, /app/
       │
       │  HTTP + WebSocket, 127.0.0.1 only
       ▼
[ tabsh daemon ]    your machine
       │
       │  PTY
       ▼
[ your shells ]     zsh, bash, fish…</pre>
      <ol class="steps">
        <li><b>Run the daemon.</b> It listens on loopback only and creates a secret token in <code>~/.tabsh/token</code>.</li>
        <li><b>Open the link it prints.</b> The token rides in the URL fragment, which browsers never send to a web server.</li>
        <li><b>That's it.</b> The daemon only accepts requests from this site that carry the token. Other sites get nothing.</li>
      </ol>
      <p class="muted">
        <span class="mark">&gt;</span> Chrome may ask to let this site access apps on your device. That's the
        connection to the daemon; allow it once. Lost the link? Open <code>{DAEMON_URL}</code> in
        this browser and the daemon sends you here, paired.
      </p>

      <p class="sig end">~*~ EOF ~*~</p>
    </main>

    <script>
      // ---- fig. 1: the interactive app demo -------------------------------
      // Static lines are trusted markup; anything typed goes in as text only.
      type DemoTab = { name: string; prompt: string; lines: string[]; input: string; bell?: boolean };
      const ok = '<span class="t-green">ok</span>';
      const tabs: DemoTab[] = [
        { name: 'shop: npm run dev', prompt: '<span class="t-dim">~/code/shop ❯</span> ', input: '', lines: [
          '<span class="t-dim">~/code/shop ❯</span> npm run dev', '',
          '  <b class="t-green">VITE</b> v6.0.3  <span class="t-dim">ready in</span> 412 ms', '',
          '  <span class="t-green">➜</span>  Local:   http://localhost:5173/',
          '  <span class="t-dim">➜  Network: use --host to expose</span>', '',
          '<span class="t-dim">12:04:51</span> <span class="t-cyan">[vite]</span> hmr update /src/Cart.tsx',
        ] },
        { name: 'api: cargo test', prompt: '<span class="t-dim">~/code/api ❯</span> ', input: '', lines: [
          '<span class="t-dim">~/code/api ❯</span> cargo test',
          '   <b class="t-green">Compiling</b> api v0.4.1 (~/code/api)',
          '    <b class="t-green">Finished</b> `test` profile [unoptimized + debuginfo] in 3.42s',
          '     <b class="t-green">Running</b> unittests src/lib.rs', '',
          'running 48 tests',
          `test auth::login ... ${ok}`, `test auth::refresh_token ... ${ok}`,
          `test cart::add_item ... ${ok}`, `test orders::refund ... ${ok}`, '',
          `test result: ${ok}. 48 passed; 0 failed; finished in 0.81s`, '',
        ] },
        { name: 'claude', bell: true, prompt: '<span class="t-orange">›</span> ', input: '', lines: [
          '<span class="t-orange">●</span> The refund path now checks the order status first.', '',
          '  <span class="t-dim">2 files changed,</span> <span class="t-green">+18</span> <span class="t-red">−4</span>', '',
          'Run the tests before I commit? <span class="t-dim">(y/n)</span>',
        ] },
      ];
      let current = 1;
      let spawned = 0;

      const tabList = document.getElementById('demo-tabs')!;
      const screen = document.getElementById('demo-screen')!;
      const badge = document.getElementById('demo-badge')!;
      document.getElementById('demo-url')!.textContent = `${location.host}/app/`;

      const line = (html: string) => { const d = document.createElement('div'); d.innerHTML = html || ' '; return d; };
      function renderScreen() {
        const t = tabs[current];
        screen.replaceChildren(...t.lines.map(line));
        const p = line(t.prompt);
        p.append(t.input, Object.assign(document.createElement('span'), { className: 'cursor' }));
        screen.append(p);
        screen.scrollTop = screen.scrollHeight;
      }
      function renderTabs() {
        tabList.replaceChildren(...tabs.map((t, i) => {
          const el = document.createElement('div');
          el.className = 'app-tab' + (t.bell ? ' bell' : '');
          el.setAttribute('role', 'tab');
          el.setAttribute('aria-selected', String(i === current));
          el.tabIndex = i === current ? 0 : -1;
          const label = document.createElement('span');
          label.textContent = t.name;
          el.append(label);
          if (tabs.length > 1) {
            const x = document.createElement('button');
            x.type = 'button'; x.className = 'x'; x.textContent = '×';
            x.setAttribute('aria-label', `Close ${t.name}`);
            x.onclick = (e) => { e.stopPropagation(); close(i); };
            el.append(x);
          }
          el.onclick = () => select(i);
          return el;
        }));
        badge.hidden = !tabs.some((t) => t.bell);
      }
      function select(i: number) {
        current = i;
        tabs[i].bell = false;
        renderTabs(); renderScreen();
      }
      function close(i: number) {
        tabs.splice(i, 1);
        if (current >= i && current > 0) current--;
        select(current);
      }
      document.getElementById('demo-new')!.onclick = () => {
        if (tabs.length >= 5) return;
        spawned++;
        tabs.push({ name: spawned > 1 ? `zsh ${spawned}` : 'zsh', prompt: '<span class="t-dim">~ ❯</span> ', input: '', lines: [] });
        select(tabs.length - 1);
        screen.focus();
      };

      // Typing goes to the active tab. Commands don't run; they point at the real thing.
      const reply = (cmd: string) => {
        if (current === tabs.findIndex((t) => t.name === 'claude') && /^y(es)?$/i.test(cmd))
          return ['<span class="t-orange">●</span> Running cargo test…', `  48 passed. Committed as <span class="t-dim">a1c9e04</span>.`];
        if (cmd === 'clear') return null;
        return [`<span class="t-dim">demo: this tab can't run</span> ${cmd.replace(/[&<>]/g, (c) => `&#${c.charCodeAt(0)};`)}<span class="t-dim">. Install tabsh for a real shell.</span>`];
      };
      screen.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = tabs[current];
        if (e.key === 'Enter') {
          const cmd = t.input.trim();
          const typed = line(t.prompt); typed.append(t.input);
          t.lines.push(typed.innerHTML);
          t.input = '';
          if (cmd) { const out = reply(cmd); if (out) t.lines.push(...out); else t.lines = []; }
          t.lines = t.lines.slice(-200);
        } else if (e.key === 'Backspace') {
          t.input = t.input.slice(0, -1);
        } else if (e.key.length === 1 && t.input.length < 60) {
          t.input += e.key;
        } else return;
        e.preventDefault();
        renderScreen();
      });
      tabList.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        select((current + step + tabs.length) % tabs.length);
        (tabList.children[current] as HTMLElement).focus();
      });
      renderTabs(); renderScreen();

      // Stretch the ASCII table to the column: measure one character, then pad
      // the second column with however many fit. Never narrower than the content.
      const tablePre = document.querySelector<HTMLPreElement>('.table');
      if (tablePre) {
        const rows: [string, string][] = JSON.parse(tablePre.dataset.rows ?? '[]');
        const w0 = Math.max(...rows.map(([a]) => a.length));
        const w1 = Math.max(...rows.map(([, b]) => b.length));
        const probe = document.createElement('span');
        probe.textContent = 'x'.repeat(100);
        probe.style.cssText = 'position:absolute;visibility:hidden';
        const draw = () => {
          tablePre.append(probe);
          const charWidth = probe.getBoundingClientRect().width / 100;
          probe.remove();
          const fit = Math.floor(tablePre.clientWidth / charWidth);
          const c1 = Math.max(w1, fit - w0 - 7); // 7 = the borders and padding around both cells
          const rule = `+${'-'.repeat(w0 + 2)}+${'-'.repeat(c1 + 2)}+`;
          tablePre.textContent = [rule, ...rows.map(([a, b]) => `| ${a.padEnd(w0)} | ${b.padEnd(c1)} |`), rule].join('\n');
        };
        document.fonts.ready.then(() => {
          draw();
          new ResizeObserver(draw).observe(tablePre);
        });
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = '[copied]';
          setTimeout(() => (btn.textContent = '[copy]'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Same palette as the app's "tabsh" theme (src/pages/app/index.astro):
       greys are mixed from bg and fg exactly as the app derives its own. */
    --bg: #f7f7f7;
    --fg: #1a1a1a;
    --line: #c9d6ec;
    --link: #3b78d8;
    --code-bg: color-mix(in srgb, var(--fg) 8%, var(--bg));
    --muted: color-mix(in srgb, var(--fg) 60%, var(--bg));
    --mono: 'Geist Mono', ui-monospace, Menlo, monospace;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414;
      --fg: #e6e6e6;
      --line: #2f4366;
      --link: #7aa7ee;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 14px/1.6 var(--mono); letter-spacing: 0; -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--fg); color: var(--bg); }

  /* fig. 1: a browser window holding the app, drawn in the same tabsh palette.
     Global because the demo script builds these elements at runtime. */
  .browser {
    --border: color-mix(in srgb, var(--fg) 14%, var(--bg));
    --chrome: color-mix(in srgb, var(--fg) 5%, var(--bg));
    --t-green: #1a7f37; --t-red: #cf222e; --t-cyan: #1b7c83; --t-orange: #f97316;
    overflow: hidden; border: 1px solid var(--border); border-radius: 10px; background: var(--bg);
    font-size: 12px; line-height: 1.5;
  }
  @media (prefers-color-scheme: dark) {
    .browser { --t-green: #8ae234; --t-red: #ef2929; --t-cyan: #34e2e2; }
  }
  .chrome { display: flex; align-items: flex-end; gap: .75rem; padding: .25rem .75rem 0; background: var(--chrome); }
  .lights { display: flex; gap: 6px; align-self: center; padding-bottom: .375rem; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
  .btab {
    display: flex; align-items: center; gap: .5rem; width: 12rem; max-width: 60%;
    padding: .375rem .625rem; border-radius: 8px 8px 0 0; background: var(--bg);
  }
  .btab .mark { margin-left: auto; }
  /* Background tabs: no fill, dimmer, split by hairlines like a real tab strip. */
  .btab.bg {
    position: relative; flex: 0 1 12rem; width: auto; min-width: 0; background: none; color: var(--muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .btab.bg svg { flex-shrink: 0; }
  .btab.bg .label { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .btab.bg + .btab.bg::before {
    content: ""; position: absolute; left: -.375rem; top: 25%; bottom: 25%; width: 1px; background: var(--border);
  }
  .btab { flex-shrink: 0; }
  @media (max-width: 720px) { .btab.bg:nth-of-type(n+4) { display: none; } }
  @media (max-width: 520px) { .btab.bg { display: none; } }
  .favicon { position: relative; display: flex; }
  .favicon img { border-radius: 3px; }
  .favicon i { position: absolute; top: -3px; right: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--t-orange); box-shadow: 0 0 0 1.5px var(--bg); }
  .urlbar { padding: .375rem .75rem; border-bottom: 1px solid var(--border); }
  .url { display: block; padding: .125rem .75rem; border-radius: 999px; background: var(--chrome); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .app-bar { display: flex; align-items: center; gap: .25rem; padding: .375rem .5rem 0; }
  .app-tabs { display: flex; gap: .25rem; min-width: 0; overflow: hidden; }
  .browser .app-tab {
    display: flex; align-items: center; gap: .375rem; flex: 0 1 auto; width: 10rem; min-width: 4rem; height: 1.625rem;
    padding: 0 .25rem 0 .5rem; border-radius: 5px; color: var(--muted); cursor: pointer; user-select: none; white-space: nowrap;
  }
  .browser .app-tab:hover { background: color-mix(in srgb, transparent 50%, var(--code-bg)); color: var(--fg); }
  .browser .app-tab[aria-selected="true"] { background: var(--code-bg); color: var(--fg); }
  .browser .app-tab:focus-visible, .browser .icon:focus-visible { outline: 1px solid var(--link); outline-offset: -1px; }
  .browser .app-tab span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .browser .app-tab.bell::before { content: ""; flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--t-orange); }
  .browser .app-tab .x, .browser .icon {
    display: grid; place-items: center; flex-shrink: 0; width: 1.25rem; height: 1.25rem; padding: 0;
    border: 0; border-radius: 4px; background: none; color: var(--muted); font: inherit; cursor: pointer;
  }
  .browser .app-tab .x { opacity: 0; }
  .browser .app-tab:hover .x, .browser .app-tab[aria-selected="true"] .x { opacity: 1; }
  .browser .app-tab .x:hover, .browser .icon:hover { background: var(--code-bg); color: var(--fg); }
  .browser .gear { margin-left: auto; cursor: default; }
  .browser .gear:hover { background: none; color: var(--muted); }

  .screen { height: 17rem; padding: .5rem .75rem; overflow: hidden; white-space: pre-wrap; overflow-wrap: anywhere; cursor: text; outline: none; }
  .browser .cursor {
    display: inline-block; width: .6em; height: 1.15em; vertical-align: -.25em;
    background: var(--fg); animation: demo-blink 1.1s steps(1) infinite;
  }
  @keyframes demo-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .browser .cursor { animation: none; } }
  /* Hollow and still until the terminal has focus, like xterm's. */
  .screen:not(:focus) .cursor { animation: none; background: none; box-shadow: inset 0 0 0 1px var(--muted); }
  .browser .t-dim { color: var(--muted); }
  .browser .t-green { color: var(--t-green); }
  .browser .t-red { color: var(--t-red); }
  .browser .t-cyan { color: var(--t-cyan); }
  .browser .t-orange { color: var(--t-orange); }
  @media (max-width: 520px) { .screen { font-size: 10.5px; height: 15rem; } .lights { display: none; } }
</style>

<style>
  main { max-width: 46rem; padding: 2.5rem 1rem 4rem; margin-inline: auto; }

  p, ul, ol, pre { margin: 0 0 1rem; }
  code { font: inherit; }
  b { font-weight: 600; }
  .mark, .muted { color: var(--muted); }

