---
import Site from '../layouts/Site.astro';
import { BREW_INSTALL_COMMAND, DAEMON_URL, INSTALL_COMMAND, REPO_URL } from '../site';

const features = [
  ['One list, every project', 'Every card in one scroll', '⌘B'],
  ['Grouped by status', 'Fold what is done', ''],
  ['Shells outlive the tab', 'Close, reload, quit: they reattach', ''],
  ['Survives restarts', 'Tabs, folders, scrollback restored', ''],
  ['Your agents, not ours', 'Claude Code, Codex, Cursor CLI…', ''],
  ['TUI or UI, per card', 'A real terminal or a chat panel', ''],
  ['No worktrees', 'Your checkout, not a copy', ''],
  ['File explorer', "Follows your shell's folder", '⌘⇧E'],
  ['Search files', 'By name, across the project', '⌘⇧F'],
  ['Click paths and URLs', 'Open, edit and save in a pane', ''],
  ['Group tabs', 'By repo or by tag', '⌘⇧Y'],
  ['Drop files in', 'Dragged files type their path', ''],
  ['A bell, not a feed', 'The tab rings; the favicon badges', ''],
  ['Themes and fonts', '12 themes, 9 fonts', '⌘K'],
  ['Nothing leaves localhost', 'Keystrokes stay on 127.0.0.1', ''],
];

// Draw the features as an ASCII table, padded to the widest cell in each column.
// The script below redraws it at runtime with a wider second column to fill the page.
const drawTable = (rows: string[][], widths: number[]) => {
  const rule = `+${widths.map((w) => '-'.repeat(w + 2)).join('+')}+`;
  const line = (row: string[]) => `|${row.map((c, i) => ` ${c.padEnd(widths[i])} `).join('|')}|`;
  return [rule, ...rows.map(line), rule].join('\n');
};
const widths = features[0].map((_, i) => Math.max(...features.map((r) => r[i].length)));
const table = drawTable(features, widths);

// The board, as ASCII: one card per column, the agent under its title.
const board = [
  ['BACKLOG', 'IN PROGRESS', 'NEEDS INPUT', 'COMPLETED'],
  ['Dark mode', 'Fix refunds', 'Bump deps', 'Add search'],
  ['claude', 'codex', 'gemini', 'opencode'],
];
const cell = 14;
const boardRule = Array(4).fill(`+${'-'.repeat(cell)}+`).join(' ');
const boardRow = (row: string[], box: boolean) =>
  row.map((c) => (box ? `| ${c.padEnd(cell - 2)} |` : ` ${c.padEnd(cell)} `)).join(' ');
const boardArt = [boardRow(board[0], false), boardRule, boardRow(board[1], true), boardRow(board[2], true), boardRule].join(
  '\n',
);
const SETUP_PROMPT = 'Run `tabsh setup` and follow it.';

---

<Site
  title="tabsh: every project, one list"
  description="A tiny Rust daemon runs your shells and agents locally. The list view keeps every card, across every project, in one browser tab."
>
      <h1><span class="mark">#</span> YOUR WHOLE BOARD, ONE LIST</h1>

      <p>
        tabsh runs your shells and agents in the browser tab next to your work.
        The list view puts every card, across every project, in one calm scroll:
        what's moving, what needs you, and what's done.
      </p>

      <pre class="cmd"><span class="mark">$</span> {INSTALL_COMMAND}  <button type="button" class="copy" data-copy={INSTALL_COMMAND} aria-label="Copy install command">[copy]</button>
<span class="mark">$</span> tabsh  <span class="mark"># opens the app in your browser, paired</span>
<span class="mark"># or Homebrew: {BREW_INSTALL_COMMAND}</span></pre>

      <p class="caption">
        <span class="mark">fig. 1</span> what you get when you install: the full app, running&nbsp;live.
        <span class="how">
          <button type="button" aria-describedby="how-tip">[how?]</button>
          <span role="tooltip" id="how-tip">
            This is the tabsh app itself, built from the same code as /app/, so it never falls behind.
            It can run here because the app is just a web page that talks to the daemon over HTTP and
            WebSocket. The demo swaps in a pretend daemon that lives in this page: scripted shells and
            files, in memory. Nothing runs on your machine, and nothing leaves the page.
          </span>
        </span>
      </p>

      <figure class="shot">
        <div class="stage">
          <div class="browser" role="group" aria-label="Interactive demo: tabsh in a browser tab">
            <div class="chrome" aria-hidden="true">
              <span class="lights"><i></i><i></i><i></i></span>
              <span class="btab">
                <span class="favicon"><img src="/favicon.svg" alt="" width="14" height="14" /><i></i></span>
                tabsh
                <span class="mark">×</span>
              </span>
              <!-- The rest of the workday, in the tabs next door. -->
              <span class="btab bg">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
                <span class="label">Fix refund status · #142</span>
              </span>
              <span class="btab bg">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="4.2" stroke-linecap="round">
                  <path stroke="#36c5f0" d="M3.5 9.5h6M9.5 3.5h0" /><path stroke="#2eb67d" d="M14.5 3.5v6M20.5 9.5h0" />
                  <path stroke="#ecb22e" d="M14.5 14.5h6M14.5 20.5h0" /><path stroke="#e01e5a" d="M9.5 14.5v6M3.5 14.5h0" />
                </svg>
                <span class="label">#shop-eng</span>
              </span>
              <span class="btab bg">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9.5" /><path d="M2.5 12h19M12 2.5c3 3.2 3 15.8 0 19M12 2.5c-3 3.2-3 15.8 0 19" /></svg>
                <span class="label">Shop · localhost:5173</span>
              </span>
            </div>
            <div class="urlbar" aria-hidden="true"><span class="url">tabsh.cc/app/?view=board&layout=list&drawer=1</span></div>
            <!-- The real app, on a pretend daemon in memory (src/demo/daemon.ts).
                 Held until the poster is clicked, so the landing page does not boot it. -->
            <div class="app">
              <button type="button" class="poster" data-run>
                <!-- One still, chosen here so the other file is never requested. -->
                <img alt="" decoding="async" data-light="/preview-light.png?v=6" data-dark="/preview-dark.png?v=6" />
                <script is:inline>
                  const still = document.currentScript.previousElementSibling;
                  const scheme = matchMedia('(prefers-color-scheme: light)');
                  const pick = () => (scheme.matches ? still.dataset.light : still.dataset.dark);
                  still.src = pick();
                  scheme.addEventListener('change', () => (still.src = pick()));
                </script>
                <span>Run the live demo</span>
              </button>
              <iframe data-click data-src="/demo/?view=board&layout=list&tab=demo-9&drawer=1" title="tabsh demo: the board with a card's chat open"></iframe>
            </div>
          </div>
        </div>
      </figure>

      <h2 id="list"><span class="mark">##</span> ONE LIST, EVERY PROJECT</h2>
      <p>
        Columns are good for moving one card. The list is for catching up. Every
        card from every project sits in the same scroll, grouped by status and
        tagged with the folder it came from.
      </p>
      <figure class="shot still-fig">
        <picture>
          <source srcset="/shots/list-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/list-light.png"
            alt="The tabsh board in list view: Backlog, In progress, Needs input, Completed and Archived groups, with cards from the shop and api projects in one scroll."
            width="2880"
            height="1800"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="caption"><span class="mark">fig. 2</span> the list view: shop and api in one scroll, grouped by status.</figcaption>
      </figure>
      <ol class="steps">
        <li>
          <b>Every project, one place.</b> A shop card and an api card sit in the
          same list. Each card keeps its folder, so you can tell them apart
          without opening a thing.
        </li>
        <li>
          <b>Grouped, not scattered.</b> Backlog, In progress, Needs input,
          Completed and Archived. Fold what's done and the board gets shorter.
        </li>
        <li>
          <b>One scroll.</b> No columns to pan, no drawer to open, no tab to
          hunt for. If a card needs you, it is already in front of you.
        </li>
      </ol>

      <h2 id="calm"><span class="mark">##</span> WHY CALMER?</h2>
      <ol class="steps">
        <li>
          <b>The board is the signal.</b> One status per card. No feed to clear,
          no unread count, no second inbox. If nothing needs you, the board says
          so and you get on with your day.
        </li>
        <li>
          <b>It lives where you already are.</b> The issue, the pull request,
          the docs and the app on localhost are already tabs. tabsh makes your
          shells and agents one more tab, instead of a window of their own.
        </li>
        <li>
          <b>Quiet by default.</b> A tab badge and one chime when a card needs
          you or is done; both can be turned off. No per-agent notification
          stream, no badge on every card.
        </li>
      </ol>

      <h2 id="agents"><span class="mark">##</span> YOUR AGENTS, YOUR CALL</h2>
      <p>
        Pick the agent per card. Claude Code, Codex, Cursor CLI and OpenCode are
        ready out of the box; any command that takes a prompt works too, up to
        12 providers. Each card runs in a real terminal (TUI) or a chat panel
        (UI), and you can switch per card. In a UI card, the model picker is
        right there in the chat.
      </p>
      <figure class="shot still-fig">
        <picture>
          <source srcset="/shots/models-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/models-light.png"
            alt="The tabsh board in list view with a UI card's chat open beside it: a long review conversation, and a model picker listing several models including DeepSeek V4.1 Flash, Claude Sonnet 4.5 and GPT-5 Codex."
            width="2880"
            height="1800"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="caption"><span class="mark">fig. 3</span> one card's chat: pick a model, keep the list in view.</figcaption>
      </figure>
      <p>
        Providers are commands. Pick one to set its startup, resume and ACP
        commands, or add any CLI that takes a prompt. <code>{'{prompt}'}</code>{' '}
        is the card's first prompt; <code>{'{session}'}</code> is a resumable
        conversation.
      </p>
      <figure class="shot still-fig provider-flow">
        <picture>
          <source srcset="/shots/providers-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/providers-light.png"
            alt="The Agent providers list in tabsh's command palette: Claude Code, Codex, Cursor CLI and OpenCode, each with its startup command, and an Add provider row."
            width="1248"
            height="664"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="flow-arrow" aria-hidden="true">↓</div>
        <picture>
          <source srcset="/shots/providers-detail-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/providers-detail-light.png"
            alt="Claude Code's provider settings in tabsh: its name, startup command, resume command and ACP command."
            width="1248"
            height="664"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="caption"><span class="mark">fig. 4</span> pick a provider, then set its startup, resume and ACP commands.</figcaption>
      </figure>
      <p>
        There is no worktree choreography. Agents run in the folder you started
        them in, on your branch. That is the trade: no isolation, so two agents
        in the same checkout can collide. tabsh doesn't hide that behind a copy
        of your repo.
      </p>

      <h2 id="remote"><span class="mark">##</span> OPTIONAL: ANOTHER DEVICE</h2>
      <p>
        The daemon listens on loopback. If you want the same board on your phone
        or another laptop, tabsh can serve itself over Tailscale: turn it on,
        scan the code, and the device is paired. Off by default, and there is no
        relay of ours in between.
      </p>
      <figure class="shot still-fig">
        <picture>
          <source srcset="/shots/tailscale-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/tailscale-light.png"
            alt="The Open on another device page in tabsh: Tailscale sharing is on, with a QR code for a new device and a list of paired devices."
            width="2880"
            height="1800"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="caption"><span class="mark">fig. 5</span> optional: serve the same board to a phone over Tailscale.</figcaption>
      </figure>

      <h2 id="board"><span class="mark">##</span> THE BOARD, LIVE</h2>
      <p>
        The board is the same cards in columns (⌘B switches between columns and
        the list). Start an agent from a new card's prompt, then watch it move
        as its hooks report in.
      </p>
      <p class="caption board-fig">
        <span class="mark">fig. 6</span> the board, live. Keep watching: two agents are about to report&nbsp;in.
      </p>
      <figure class="shot board-fig">
        <div class="browser board" role="group" aria-label="Interactive demo: the tabsh board">
          <div class="urlbar" aria-hidden="true">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="url">tabsh.cc/app/?view=board</span>
          </div>
          <!-- The same demo as fig. 1, opened on the board: a fuller one, with scripted hooks. -->
          <div class="app"><iframe data-src="/demo/?view=board" title="tabsh demo: the board"></iframe></div>
        </div>
      </figure>
      <pre class="art" aria-label="A board with four columns: Backlog, In progress, Needs input and Completed, one agent's card in each">{boardArt}</pre>
      <p>Tell Claude Code, Codex, Cursor CLI, OpenCode or any agent with hooks:</p>
      <pre class="cmd"><span class="mark">&gt;</span> {SETUP_PROMPT}  <button type="button" class="copy" data-copy={SETUP_PROMPT} aria-label="Copy setup prompt">[copy]</button></pre>
      <ol class="steps">
        <li><b>It wires its own hooks</b> to <code>tabsh status</code>. Outside tabsh they do nothing.</li>
        <li><b>A prompt moves the card to In progress.</b> A question or a stop moves it to Needs input; finished work lands in Completed.</li>
        <li><b>You hear about it.</b> A desktop notification and a chime when an agent needs you or is done.</li>
        <li><b>Agents pick up where they left off</b> when tabsh restarts.</li>
      </ol>
      <p class="muted"><span class="mark">&gt;</span> <a href="/docs/">How to set this up</a>, the hooks the agent runs, how to undo it, and <a href="/docs/#tailscale">Tailscale</a> if you need another device.</p>

      <h2 id="differs"><span class="mark">##</span> HOW IT DIFFERS</h2>
      <p>
        Most agent tools ask you to move into a new app. tabsh adds a view to
        the one you already have.
      </p>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr><th></th><th>tabsh</th><th>Agent IDEs</th><th>Agent control planes</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Where it lives</th><td>A browser tab you already have</td><td>A new editor window</td><td>A new desktop or web app</td></tr>
            <tr><th scope="row">What you watch</th><td>One board, one list</td><td>The editor, plus notifications</td><td>A kanban or a queue</td></tr>
            <tr><th scope="row">Signal</th><td>A tab badge and one chime</td><td>OS notifications, often more</td><td>An inbox, mentions, badges</td></tr>
            <tr><th scope="row">Agents</th><td>Claude Code, Codex, Cursor CLI, OpenCode, any command</td><td>Usually the editor's own agent</td><td>A fixed set, or bring your own</td></tr>
            <tr><th scope="row">TUI or UI</th><td>Per card</td><td>Chat-first</td><td>Varies</td></tr>
            <tr><th scope="row">Isolation</th><td>None: your checkout</td><td>Worktrees or copies</td><td>Worktrees or containers</td></tr>
            <tr><th scope="row">Setup</th><td>One daemon, one browser tab</td><td>Install the editor</td><td>Sign in, connect a repo</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted">
        <span class="mark">&gt;</span> Agent IDEs: Zed, Cursor. Agent control planes: T3 Code, Conductor,
        Vibe Kanban. Zed can quiet its notifications, and T3 Code has a good mobile app; the
        difference is that tabsh doesn't ask you to add another surface to your day.
      </p>

      <h2 id="features"><span class="mark">##</span> FEATURES</h2>
      <pre class="table" data-rows={JSON.stringify(features)}>{table}</pre>
      <p class="muted"><span class="mark">&gt;</span> Keys are the Mac defaults. Change any of them from ⌘K.</p>

      <h2 id="how"><span class="mark">##</span> HOW IT CONNECTS</h2>
      <p>
        The app you open here is a plain page. It talks to the daemon on your own
        machine at <code>{DAEMON_URL}</code>. There is no server of ours in between.
      </p>
      <pre class="diagram">[ browser tab ]     this site, /app/
       │
       │  HTTP + WebSocket, 127.0.0.1 only
       ▼
[ tabsh daemon ]    your machine
       │
       │  PTY
       ▼
[ your shells ]     zsh, bash, fish…</pre>
      <ol class="steps">
        <li><b>Run the daemon.</b> It listens on loopback only and creates a secret token in <code>~/.tabsh/token</code>.</li>
        <li><b>Open the link it prints.</b> The token rides in the URL fragment, which browsers never send to a web server.</li>
        <li><b>That's it.</b> The daemon only accepts requests from this site that carry the token. Other sites get nothing.</li>
      </ol>
      <p class="muted">
        <span class="mark">&gt;</span> Chrome may ask to let this site access apps on your device. That's the
        connection to the daemon; allow it once. Lost the link? Open <code>{DAEMON_URL}</code> in
        this browser and the daemon sends you here, paired.
      </p>

      <h2 id="faq"><span class="mark">##</span> FAQ</h2>
      <div class="faq">
        <details>
          <summary>What's the difference between the board and the list?</summary>
          <p>
            The board is columns you drag cards across. The list is the same cards in one scroll,
            grouped by status. ⌘B switches between them; the list is the one for catching up.
          </p>
        </details>
        <details>
          <summary>Does it work in Safari?</summary>
          <p>
            Safari (and every iOS browser) won't let this site reach the daemon, so the daemon serves
            the app itself at <code>http://tabsh.localhost:7681</code>, and this site sends Safari there.
            File → Add to Dock opens it like an app.
          </p>
        </details>
        <details>
          <summary>Why does Chrome ask to access apps on my device?</summary>
          <p>That's the connection to the daemon on your machine. Allow it once.</p>
        </details>
        <details>
          <summary>Is it safe?</summary>
          <p>
            The daemon listens on 127.0.0.1 only and answers only the tabsh app carrying your token. The
            token rides in the URL fragment, which browsers never send to a server. Keystrokes never
            leave your machine.
          </p>
        </details>
        <details>
          <summary>Can I open it from my phone or another computer?</summary>
          <p>
            Keep the daemon on loopback — exposing the port on the network would be plain HTTP to a
            shell. If you need another of your devices, put Tailscale (Serve or an SSH tunnel) in
            front of it. Use the Tailscale IP, not MagicDNS. <a href="/docs/#tailscale">How to set that up</a>.
          </p>
        </details>
        <details>
          <summary>Can it keep running after I close the terminal?</summary>
          <p>
            With Homebrew, <code>brew services start tabsh</code> runs it from login. Then open
            <code>{DAEMON_URL}</code> once to pair this browser.
          </p>
        </details>
        <details>
          <summary>Which agents does the board work with?</summary>
          <p>
            Claude Code, Codex, Cursor CLI and OpenCode out of the box, resumed after restarts. Any
            other command works for a new card, and any agent with hooks can keep its card current.
            Each card can run in a real terminal or a chat panel. <a href="/docs/">How to connect one</a>.
          </p>
        </details>
        <details>
          <summary>Do you use worktrees?</summary>
          <p>
            No. Agents run in the folder you started them in, on your branch. That keeps setup
            simple and means they share the checkout; run one agent per folder if they would edit
            the same files.
          </p>
        </details>
        <details>
          <summary>Which systems does it run on?</summary>
          <p>macOS and Linux. There's no Windows build.</p>
        </details>
        <details>
          <summary>How do I upgrade?</summary>
          <p>
            With Homebrew: <code>brew upgrade tabsh</code>, then <code>brew services restart tabsh</code> if you run it as a service.
            With the install script: re-run it.
          </p>
        </details>
        <details>
          <summary>Lost the link?</summary>
          <p>Open <code>{DAEMON_URL}</code> in the same browser and the daemon sends you back to the app, paired.</p>
        </details>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. It's open source under the MIT license, on <a href={REPO_URL}>GitHub</a>.</p>
        </details>
      </div>

      <h2 id="install"><span class="mark">##</span> GET IT</h2>
      <pre class="cmd"><span class="mark">$</span> {INSTALL_COMMAND}  <button type="button" class="copy" data-copy={INSTALL_COMMAND} aria-label="Copy install command">[copy]</button>
<span class="mark">$</span> tabsh</pre>

      <p class="sig end">~*~ EOF ~*~</p>

  <Fragment slot="after">

    <script>
      // Stretch the ASCII table to the column: measure one character, then pad
      // the second column with however many fit. Never narrower than the content.
      const tablePre = document.querySelector<HTMLPreElement>('.table');
      if (tablePre) {
        const rows: string[][] = JSON.parse(tablePre.dataset.rows ?? '[]');
        const widths = rows[0].map((_, i) => Math.max(...rows.map((r) => r[i].length)));
        const probe = document.createElement('span');
        probe.textContent = 'x'.repeat(100);
        probe.style.cssText = 'position:absolute;visibility:hidden';
        const draw = () => {
          tablePre.append(probe);
          const charWidth = probe.getBoundingClientRect().width / 100;
          probe.remove();
          const fit = Math.floor(tablePre.clientWidth / charWidth);
          // Each column costs its width plus 3 (a border and a space either side), plus the last border.
          const others = widths.reduce((sum, w, i) => (i === 1 ? sum : sum + w + 3), 1);
          const w = widths.map((x, i) => (i === 1 ? Math.max(x, fit - others - 3) : x));
          const rule = `+${w.map((x) => '-'.repeat(x + 2)).join('+')}+`;
          const line = (row: string[]) => `|${row.map((c, i) => ` ${c.padEnd(w[i])} `).join('|')}|`;
          tablePre.textContent = [rule, ...rows.map(line), rule].join('\n');
        };
        document.fonts.ready.then(() => {
          draw();
          new ResizeObserver(draw).observe(tablePre);
        });
      }

      // Fig. 1 waits for a click. The others load as they near the screen.
      // Not with loading="lazy": WebKit gives a lazily loaded frame no
      // Navigation API entry, so every navigation in it aborts and the app's
      // router never shows a tab.
      const frames = new IntersectionObserver(
        (entries) => {
          for (const { isIntersecting, target } of entries) {
            if (!isIntersecting || !(target instanceof HTMLIFrameElement)) continue;
            frames.unobserve(target);
            target.src = target.dataset.src ?? '';
          }
        },
        { rootMargin: '600px 0px' },
      );
      for (const frame of document.querySelectorAll('iframe[data-src]:not([data-click])')) frames.observe(frame);
      for (const poster of document.querySelectorAll('[data-run]')) {
        poster.addEventListener('click', () => {
          const frame = poster.parentElement?.querySelector('iframe[data-src]');
          if (!(frame instanceof HTMLIFrameElement) || frame.getAttribute('src')) return;
          frame.src = frame.dataset.src ?? '';
          poster.remove();
        });
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = '[copied]';
          setTimeout(() => (btn.textContent = '[copy]'), 1500);
        });
