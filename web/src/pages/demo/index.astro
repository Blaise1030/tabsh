---
import { DEMO } from '../../demo/origin.ts';
import '../../styles/app.css';
---
<!doctype html>
<html class="dark">
<head>
  <meta charset="utf-8">
  <!-- The app, framed on the landing page, talking to a pretend daemon in
       memory (demo/daemon.ts) instead of the visitor's. -->
  <meta name="tabsh-daemon" content={DEMO}>
  <!-- maximum-scale stops iOS zooming into a focused field smaller than 16px;
       Safari still lets the reader pinch-zoom. -->
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <title>tabsh demo</title>
  <link rel="icon" id="favicon" type="image/svg+xml" href="data:,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;600&display=swap">
  <!-- Pinned with integrity: this page holds a token that opens shells. -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/basecoat.cdn.min.css" integrity="sha384-XWKdrxzE2X33lI8Q03C9fIbqdLWV11whVNycR2/3bMNJY73EEQOa7rmN+SeiSCor" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@6.0.0/css/xterm.min.css" integrity="sha384-eDYu/eBZQNhtqTaA7Wl3XighXKxm/9VYF+Chh3hQS+UUlKQIJ14hK2imKu4n99aR" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/basecoat.min.js" integrity="sha384-K1w/8BZNQc+02JnyibbylrLXh4mBzvzNIl0PZduEsb7JPR5GhJyrmsEVGQV7JTa+" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/command.min.js" integrity="sha384-i7Raf25qcUmot+J0dl2Hn1aKTz8JFiyFSRou847lNsO/CY+hA8SemZyxteOLd1hm" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/dropdown-menu.min.js" integrity="sha384-rZchjhID3eBYhQ9f7S3aJxlYZJt9QEW6M9GPzQe6Z7SF24v+4o/mS9xW+eHZokpR" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@6.0.0/lib/xterm.min.js" integrity="sha384-pELe6ZHtFxFcuYBq3gMkqvmnNIqUWnAYjBG5gThqQQCjWp8PJ/65MLK4lMIfEK1e" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.11.0/lib/addon-fit.min.js" integrity="sha384-UwMkGaBqfOcrTjPjXdAPWrGQkhpxTJ21vKtTwLb6wBpBM8HQXKAiUuwVJfgY0Yw6" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-webgl@0.19.0/lib/addon-webgl.min.js" integrity="sha384-XZQCtld4fwfpp4rw06rg+kVzIfVqv4G0UG7Em8oCawdlHA4L92O9pA7fJrDpLNG3" crossorigin="anonymous"></script>
</head>
<body>
  <div id="app"></div>
  <script>
    // Replaces fetch, WebSocket and storage, then starts the app. The app is
    // not imported here: a static import is evaluated first, and its opening
    // /api/about would be a real request, which this page's connect-src refuses.
    import '../../demo/daemon.ts';
  </script>
</body>
</html>
